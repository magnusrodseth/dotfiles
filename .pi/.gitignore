agent/auth.json
agent/sessions/
agent/git/
agent/taskplane/
# Installed extensions are pi-managed, except the dotfiles-authored ones.
# Must be `extensions/*` rather than `extensions/`: git never descends into an
# excluded directory, so a negation under one is silently dead.
agent/extensions/*
!agent/extensions/claude-parity/
agent/themes/
suggester/
taskplane.json
agents/

# Runtime state regenerated by pi: LMDB frecency/history DBs and MCP cache.
# Authored config (prompts/, settings.json, skills/ symlinks, vibes/) stays tracked.
agent/fff/
agent/pi-pretty/fff/
agent/mcp-cache.json
agent/mcp-npx-cache.json
agent/models-store.json
cc-my-pi-update-check.json

# Crash dumps. Written on a pi crash, holds a stack trace plus whatever was in
# scope at the time, and is never read back by anything.
agent/pi-crash.log

# Pi's newer top-level skill root, as opposed to the tracked agent/skills/ above.
# Leading slash matters: a bare `skills/` is a segment pattern and would swallow
# agent/skills/ too, silently untracking those 33 reproducible symlinks.
#
# Only entry so far is pptx, a symlink to ~/.agents/skills/pptx that is in
# neither skill-lock.json nor git, so it resolves on this machine and nowhere
# else. Tracking it bare would recreate the dangling-symlink class purged on
# 28.07.2026 (see the .config/devin/skills/ note in the root .gitignore);
# writing-great-skills is the surviving instance and doctor still fails on it.
# Vendoring it is not an option either: the skill is Anthropic proprietary and
# its LICENSE.txt forbids retaining copies outside the Services, reproduction,
# and distribution to third parties. This repo is public.
/skills/
