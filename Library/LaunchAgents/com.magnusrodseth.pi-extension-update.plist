<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.magnusrodseth.pi-extension-update</string>

    <!-- $HOME is expanded by zsh at run time, not by launchd, so this plist
         stays valid on any machine regardless of the account's short name.
         The script owns its own log; this redirect only catches launchd-level
         failures (missing script, bad interpreter) that never reach it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>exec /bin/bash "$HOME/dotfiles/scripts/pi/update-extensions.sh" &gt;&gt; "$HOME/Library/Logs/pi-extension-update.log" 2&gt;&amp;1</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Never let package maintenance compete with interactive work. -->
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
